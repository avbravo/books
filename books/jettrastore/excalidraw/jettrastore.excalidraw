    {
      "id": "rpy6dO6-IoLs8HNSJKQ1X",
      "type": "text",
      "x": 253.53461710611975,
      "y": -1426.3012152777776,
      "width": 800,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
